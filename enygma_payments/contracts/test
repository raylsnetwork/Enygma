# Example relayer invocation. Replace the placeholders with your own values —
# never commit real keys or tokens. Generate a fresh RELAYER_API_KEY per
# deployment; do not reuse the value below or any value that has appeared in
# git history.
RELAYER_RPC_URL=https://mainnet-rpc.rayls.com \
RELAYER_CHAIN_ID=72957 \
RELAYER_PRIVATE_KEY=$MY_KEY \
RELAYER_API_KEY=$MY_API_KEY \
RELAYER_GAS_LIMIT=10000000 \
./run.sh

# Equivalent, run from inside enygma_payments/relayer with `go run` instead
# of the ./run.sh wrapper:
cd enygma_payments/relayer
RELAYER_PRIVATE_KEY=$MY_KEY \
RELAYER_API_KEY=$MY_API_KEY \
RELAYER_RPC_URL=https://mainnet-rpc.rayls.com \
RELAYER_CHAIN_ID=72957 \
go run main.go
