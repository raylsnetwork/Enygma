# ── Required ──────────────────────────────────────────────────────────────────
# Hex-encoded ECDSA private key for the relayer's signing wallet (no 0x prefix).
# This address must be funded with gas and registered as a participant in Enygma.
RELAYER_PRIVATE_KEY=<your-hex-private-key>

# Bearer token that all clients must send with every /relay/* request.
#   Authorization: Bearer <value>
RELAYER_API_KEY=<choose-a-strong-random-token>

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# Ethereum-compatible JSON-RPC endpoint.
RELAYER_RPC_URL=http://127.0.0.1:8545

# EIP-155 chain ID.  1337 = Hardhat local.  149401 = Rayls.
RELAYER_CHAIN_ID=1337

# Deployed Enygma contract address (hex).
# If empty, the relayer reads it from RELAYER_ADDRESS_JSON instead.
RELAYER_CONTRACT_ADDR=

# Path to address.json written by the deploy script.
RELAYER_ADDRESS_JSON=../go_client/address.json

# ZkDVP Merkle-tree insert endpoint — called after a confirmed withdraw.
RELAYER_ZKDVP_INSERT_URL=http://127.0.0.1:3001/insertMerkleTree

# HTTP listen port for the relayer server.
RELAYER_PORT=8082

# Gas limit applied to every on-chain submission (300 M = Hardhat default).
RELAYER_GAS_LIMIT=300000000
