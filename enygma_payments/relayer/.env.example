# ── Required ──────────────────────────────────────────────────────────────────
# Hex-encoded ECDSA private key for the relayer's signing wallet (no 0x prefix).
# This address must be funded with gas and registered as a participant in Enygma.
RELAYER_PRIVATE_KEY=<your-hex-private-key>

# Per-bank Bearer tokens: "bankId:token,bankId:token,...". Each bank sends
# its own token — Authorization: Bearer <its-token> — so requests can be
# attributed and one bank's credential revoked (drop its entry) without
# touching anyone else's.
# Fix H-06: this replaces the old single shared RELAYER_API_KEY, under which
# every bank presented the identical string, so the relayer could not tell
# who sent a request, audit per-bank activity, or revoke one bank without
# locking out every other bank simultaneously.
RELAYER_API_KEYS=bank-a:<choose-a-strong-random-token>,bank-b:<choose-a-different-strong-random-token>

# Deprecated: a single shared token for every caller (Fix H-06 — see above).
# Only read if RELAYER_API_KEYS is unset. Kept for backward compatibility;
# new deployments should use RELAYER_API_KEYS instead.
# RELAYER_API_KEY=<choose-a-strong-random-token>

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# Ethereum-compatible JSON-RPC endpoint.
RELAYER_RPC_URL=http://127.0.0.1:8545

# EIP-155 chain ID.  1337 = Hardhat local.  72957 = Rayls mainnet.
# Fix M-07: this used to say 149401, which does not match the 72957 used
# everywhere else in this repo (run_scripts/deploy_direct.py's old
# default, go_client/enygma_test's chainID constant) — self-inconsistent,
# not a second real chain.
RELAYER_CHAIN_ID=1337

# Deployed Enygma contract address (hex).
# If empty, the relayer reads it from RELAYER_ADDRESS_JSON instead.
RELAYER_CONTRACT_ADDR=

# Path to address.json written by the deploy script.
RELAYER_ADDRESS_JSON=../go_client/address.json

# ZkDVP Merkle-tree insert endpoint — called after a confirmed withdraw.
RELAYER_ZKDVP_INSERT_URL=http://127.0.0.1:3001/insertMerkleTree

# HTTP listen port for the relayer server.
RELAYER_PORT=8082

# Gas limit applied to every on-chain submission. Default (unset, or 0):
# let go-ethereum estimate it via eth_estimateGas, which simulates the call
# first and rejects a guaranteed-to-revert payload locally instead of
# signing and broadcasting it (Fix H-10). Only set this to a fixed value if
# gas estimation is known to be unreliable on your target chain — doing so
# disables that pre-flight check.
# RELAYER_GAS_LIMIT=5000000
