# ── Required ──────────────────────────────────────────────────────────────────
# Hex-encoded ECDSA private key for the relayer's signing wallet (no 0x prefix).
# This address must be funded with gas.
RELAYER_PRIVATE_KEY=<your-hex-private-key>

# Bearer token that all clients must send with every /relay/* request.
#   Authorization: Bearer <value>
RELAYER_API_KEY=<choose-a-strong-random-token>

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# Ethereum-compatible JSON-RPC endpoint.
RELAYER_RPC_URL=http://localhost:8545

# EIP-155 chain ID. 1337 = Hardhat local.
RELAYER_CHAIN_ID=1337

# Deployed contract addresses (hex). If any is empty, the relayer reads it
# from RELAYER_RECEIPTS_PATH instead.
RELAYER_DVP_ADDR=
RELAYER_ERC20_VAULT_ADDR=

# TagRegistry / TagChannelRegistry addresses — needed only for POST /relay/tag
# and POST /relay/channel. If empty, the relayer reads them from
# RELAYER_RECEIPTS_PATH; if still unset there, those two endpoints return 503
# but payment relaying still works.
RELAYER_TAG_REGISTRY_ADDR=
RELAYER_TAG_CHANNEL_REGISTRY_ADDR=

# Path to build/receipts.json written by scripts/deploy.go.
RELAYER_RECEIPTS_PATH=../build/receipts.json

# HTTP listen port for the relayer server.
RELAYER_PORT=8090

# Minimum value required at publicSignal[8] (the PaymentRelayerFeePublic
# circuit's public StFee slot) for POST /relay/payment_fee. Requests whose
# proof commits to a lower fee are rejected with 402 before any on-chain
# call. 0 = disabled (any fee, including 0, is accepted) — set this
# explicitly in production; a relayer that never checks the fee sponsors
# other people's gas for free.
RELAYER_MIN_FEE=0

# Paths to the Groth16 verifying keys (BN254, gnark's native .key format —
# the same files gnark_circuits loads to prove) used for local, in-process
# proof verification before any network call. Verifying keys are public data.
RELAYER_VK_PAYMENT_PATH=../gnark_circuits/scripts/keys/PaymentVK.key
RELAYER_VK_RELAYER_FEE_PATH=../gnark_circuits/scripts/keys/PaymentRelayerFeePublicVK.key

# Per-caller (Bearer token) rate limit on POST /relay/*. Requests over the
# limit get 429 before any proof verification, chain call, or gas spend.
# 0 RPS disables the limit entirely; burst has no separate "disabled" value
# and must be >= 1 whenever RPS > 0.
RELAYER_RATE_LIMIT_RPS=5
RELAYER_RATE_LIMIT_BURST=10

# Wallet balance floor (wei) checked by GET /health/ready. 0 disables the
# balance check — RPC connectivity is still checked regardless.
RELAYER_MIN_BALANCE_WEI=0

# Where the persistent idempotency store (bbolt-backed) lives on disk. A
# crash between broadcasting a tx and responding no longer loses this state.
RELAYER_STORE_PATH=./relayer_state.db

# How long a claimed-but-not-yet-terminal request blocks a retry before it's
# treated as abandoned (e.g. the relayer crashed mid-flight) and the same
# proof becomes submittable again. Should comfortably exceed how long a
# submission can legitimately take.
RELAYER_DEDUP_STALENESS=5m
